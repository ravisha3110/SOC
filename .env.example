# =====================================================================
# CyberShield - Environment Configuration Template
# =====================================================================
# IMPORTANT: Copy this file to '.env' and provide appropriate values.
# NEVER commit the actual '.env' file containing real secrets to Git.

# Application Environment
CYBERSHIELD_ENV=development
CYBERSHIELD_DEBUG=True
CYBERSHIELD_APP_TITLE=CyberShield - SOC Threat Analytics
CYBERSHIELD_THEME=dark

# Local Database Configuration (SQLite)
SQLITE_DB_PATH=database/cybershield.db

# Cloud Database Configuration (Neon PostgreSQL - Phase 2)
# Format: postgresql://<user>:<password>@<ep-hostname>.neon.tech/<dbname>?sslmode=require
NEON_DATABASE_URL=
DATABASE_URL=

# Backend API Configuration (FastAPI - Planned for Phase 3)
API_HOST=127.0.0.1
API_PORT=8000

